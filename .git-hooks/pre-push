#!/bin/sh
# To setup git hooks run:
#   > git config core.hooksPath .git-hooks || echo 'Not in a git repo'
echo "Running .git-hooks/pre-push — checking 100% test coverage..."
# Git exports GIT_DIR (and more) to hooks; tests that create temporary
# repositories would otherwise operate on this repository instead.
# `git rev-parse --local-env-vars` is git's own complete list of these
# variables — more complete, and harder to silently drift stale, than a
# hand-maintained enumeration (matching .git-hooks/pre-commit's own fix).
unset $(git rev-parse --local-env-vars)

COVER_OUT=$(mktemp)
trap 'rm -f "$COVER_OUT"' EXIT

# Routed through `wb run --` when WB is installed, so a full suite is admitted
# against the machine-wide CPU budget instead of competing blindly: three
# agents running `go test` concurrently on a 4-core host were once recorded
# queueing invisibly for 10-25 minutes. It also records a per-command receipt
# (duration, CPU, queue wait, exit code). `wb run --` preserves the command's
# standard streams and exit code, so the status check below is unaffected.
#
# No `-count=1`: `-coverprofile` is one of Go's cacheable test flags (see
# `go help test`), so cached packages still report their coverage and the
# computed total is unchanged. `-count=1` was the only thing defeating the
# cache; removing it measured ~45x faster on the equivalent hook in
# dal-go/dalgo (23s -> 0.5s) with an identical 100.0% total.
if command -v wb >/dev/null 2>&1; then
  wb run -- go test ./... -coverprofile="$COVER_OUT" -covermode=atomic
else
  go test ./... -coverprofile="$COVER_OUT" -covermode=atomic
fi
# Status of the branch actually taken above.
if [ $? -ne 0 ]; then
  echo "FAIL: tests did not pass"
  exit 1
fi

PCT=$(go tool cover -func="$COVER_OUT" | awk '/^total:/ {gsub(/%/,""); print $NF}')
echo "Total coverage: ${PCT}%"
if [ "$(echo "$PCT < 100" | bc -l)" -eq 1 ]; then
  echo "FAIL: coverage ${PCT}% is below 100% threshold"
  go tool cover -func="$COVER_OUT" | grep -v '100.0%'
  exit 1
fi

echo "OK: 100% coverage"
